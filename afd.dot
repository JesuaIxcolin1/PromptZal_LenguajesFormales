digraph AFD {
rankdir=LR;

graph [bgcolor="#F7F4EA", pad="0.4", nodesep="0.7", ranksep="1.2", dpi=180];
node [fontname="Arial", fontsize=12, style=filled, fillcolor="#F1F8F5", color="#007A5E"];
edge [fontname="Arial", fontsize=10, color="#444444"];

inicio [shape=point];
inicio -> INICIAL;

DIRECTIVA [shape=doublecircle];
CADENA_ACEPTADA [shape=doublecircle];
ENTERO [shape=doublecircle];
DECIMAL [shape=doublecircle];
IDENTIFICADOR [shape=doublecircle];
CONECTOR [shape=doublecircle];
OPERADOR [shape=doublecircle];
DELIMITADOR [shape=doublecircle];
COMENTARIO_LINEA [shape=doublecircle];
COMENTARIO_BLOQUE_CERRADO [shape=doublecircle];

ERROR [shape=circle];

INICIAL -> INICIAL [label="espacio, tab, salto de linea"];
INICIAL -> ARROBA [label="@"];
INICIAL -> CADENA [label="comilla doble"];
INICIAL -> ENTERO [label="digito"];
INICIAL -> IDENTIFICADOR [label="letra, _"];
INICIAL -> SLASH [label="/"];
INICIAL -> GUION [label="-"];
INICIAL -> OPERADOR [label="=, +"];
INICIAL -> DELIMITADOR [label="{ } ( ) , ;"];
INICIAL -> ERROR [label="otro"];

ARROBA -> DIRECTIVA [label="letra"];
ARROBA -> ERROR [label="otro"];
DIRECTIVA -> DIRECTIVA [label="letra"];

CADENA -> CADENA [label="caracter diferente de comilla y salto de linea"];
CADENA -> CADENA_ACEPTADA [label="comilla doble"];
CADENA -> ERROR [label="salto de linea"];

ENTERO -> ENTERO [label="digito"];
ENTERO -> PUNTO_DECIMAL [label="."];
PUNTO_DECIMAL -> DECIMAL [label="digito"];
PUNTO_DECIMAL -> ERROR [label="otro"];
DECIMAL -> DECIMAL [label="digito"];

IDENTIFICADOR -> IDENTIFICADOR [label="letra, digito, _"];

SLASH -> COMENTARIO_LINEA [label="/"];
SLASH -> COMENTARIO_BLOQUE [label="*"];
SLASH -> ERROR [label="otro"];

COMENTARIO_LINEA -> COMENTARIO_LINEA [label="caracter diferente de salto"];

COMENTARIO_BLOQUE -> COMENTARIO_BLOQUE [label="caracter diferente de *"];
COMENTARIO_BLOQUE -> ASTERISCO_COMENTARIO [label="*"];
ASTERISCO_COMENTARIO -> COMENTARIO_BLOQUE_CERRADO [label="/"];
ASTERISCO_COMENTARIO -> ASTERISCO_COMENTARIO [label="*"];
ASTERISCO_COMENTARIO -> COMENTARIO_BLOQUE [label="otro"];

GUION -> CONECTOR [label=">"];
GUION -> ERROR [label="otro"];

}
